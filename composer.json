{
    "name": "snt2/snt_quotes",
    "description": "SNT2 - Devis sans tunnel de commande (PrestaShop 8.2 / 9.x)",
    "type": "prestashop-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "SNT2"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Snt\\Quotes\\": "src/"
        },
        "classmap": [
            "classes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Snt\\Quotes\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "prepend-autoloader": false,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "stan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
